<div class="block_iomad_category_courses_view container-fluid px-0">
    <div class="header-banner {{#hasheaderimage}}has-bg{{/hasheaderimage}}" 
         style="{{#hasheaderimage}}background-image: url('{{headerimage}}');{{/hasheaderimage}}{{^hasheaderimage}}background-color: {{headercolor}};{{/hasheaderimage}}">
        <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
            <div>
                <h1 class="display-6 fw-bold mb-1">{{sectionname}}</h1>
                <p class="lead mb-0 opacity-75">{{coursescount}} {{#str}} courses, moodle {{/str}} disponibles</p>
            </div>
            <a href="{{backurl}}" class="btn btn-light btn-sm fw-semibold shadow-sm">
                <i class="fa fa-arrow-left me-1" aria-hidden="true"></i> {{#str}} back, block_iomad_category_courses {{/str}}
            </a>
        </div>
    </div>

    {{#hascourses}}
    <div class="courses-section mb-4">
        <div class="row g-4">
            {{#courses}}
            <div class="col-md-4 col-sm-6">
                <div class="card card-course h-100">
                    {{#hasimage}}
                    <div class="course-banner" style="background-image: url('{{imageurl}}');"></div>
                    {{/hasimage}}
                    {{^hasimage}}
                    <div class="course-banner" style="background-color: {{color}};"></div>
                    {{/hasimage}}

                    <div class="card-body d-flex flex-column justify-content-between p-3">
                        <div>
                            <h5 class="fw-bold mb-2 text-dark">{{fullname}}</h5>
                            {{#summary}}
                            <p class="text-muted small mb-3">{{summary}}</p>
                            {{/summary}}
                        </div>
                        <a href="{{url}}" class="btn btn-outline-primary w-100 fw-semibold mt-auto">
                            {{#str}} gotocourse, block_iomad_category_courses {{/str}} <i class="fa fa-external-link ms-1" aria-hidden="true"></i>
                        </a>
                    </div>
                </div>
            </div>
            {{/courses}}
        </div>
    </div>
    {{/hascourses}}

    {{^hascourses}}
    <div class="alert alert-info my-4" role="alert">
        <i class="fa fa-info-circle me-1" aria-hidden="true"></i> {{#str}} nocoursesincategory, block_iomad_category_courses {{/str}}
    </div>
    {{/hascourses}}
</div>
