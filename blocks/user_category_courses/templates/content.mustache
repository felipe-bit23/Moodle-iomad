<div class="block_user_category_courses">
    {{#hascategories}}
        <div class="row g-3">
            {{#categories}}
                <div class="{{colclass}} mb-3">
                    <div class="card h-100 shadow-sm category-card">
                        
                        {{#hasimage}}
                            <div class="card-header-banner">
                                <a href="{{url}}"><img src="{{imageurl}}" alt="{{name}}" loading="lazy"></a>
                                <span class="category-badge">{{coursecount}} cursos</span>
                            </div>
                        {{/hasimage}}
                        {{^hasimage}}
                            <div class="card-header-banner card-header-color" style="background: linear-gradient(135deg, {{color}}, rgba(0,0,0,0.3)); background-color: {{color}};">
                                <a href="{{url}}" class="text-decoration-none"><div class="category-initials">{{initials}}</div></a>
                                <span class="category-badge">{{coursecount}} cursos</span>
                            </div>
                        {{/hasimage}}

                        <div class="card-body d-flex flex-column">
                            <h5 class="card-title mb-3 text-truncate" title="{{name}}">
                                <a href="{{url}}" class="text-decoration-none text-dark font-weight-bold">{{name}}</a>
                            </h5>
                            
                            <div class="mt-auto">
                                <a href="{{url}}" class="btn btn-sm btn-primary w-100 font-weight-bold d-flex align-items-center justify-content-center">
                                    <span>{{#str}} viewcategoryandcourses, block_user_category_courses {{/str}}</span>
                                    <i class="fa fa-chevron-right ms-2 ml-2" aria-hidden="true"></i>
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            {{/categories}}
        </div>
    {{/hascategories}}
</div>
