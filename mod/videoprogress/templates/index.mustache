{{!
    @template mod_videoprogress/index

    Example context (json):
    {
        "coursename": "Curso de exemplo",
        "hasactivities": true,
        "activities": [
            {
                "viewurl": "/mod/videoprogress/view.php?id=10",
                "name": "Vídeo de exemplo",
                "completionpercent": 80,
                "canreport": true,
                "reporturl": "/mod/videoprogress/report/report.php?id=10"
            }
        ]
    }
}}

<div class="videoprogress-index">
    <h2>{{#str}} modulenameplural, videoprogress {{/str}}</h2>
    {{#hasactivities}}
        <div class="videoprogress-index__list">
            {{#activities}}
                <article>
                    <h3><a href="{{{viewurl}}}">{{{name}}}</a></h3>
                    <p>{{#str}} indexrequirement, videoprogress, {{{completionpercent}}} {{/str}}</p>
                    {{#canreport}}
                        <a href="{{{reporturl}}}" class="btn btn-outline-primary">{{#str}}viewreport, videoprogress {{/str}}</a>
                    {{/canreport}}
                </article>
            {{/activities}}
        </div>
    {{/hasactivities}}
    {{^hasactivities}}
        <p>{{#str}} noactivities, videoprogress {{/str}}</p>
    {{/hasactivities}}
</div>
