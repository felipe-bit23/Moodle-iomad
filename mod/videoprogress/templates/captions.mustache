{{!
    @template mod_videoprogress/captions

    Example context (json):
    {
        "backurl": "/mod/videoprogress/view.php?id=10",
        "activityname": "Vídeo de exemplo",
        "formhtml": "<form><input type=\"file\" name=\"caption\"></form>",
        "hascaptions": true,
        "captions": [
            {
                "label": "Portuguese (Brazil)",
                "language": "pt-BR",
                "status": "Published",
                "source": "Nextcloud URL",
                "sourceurl": "https://cloud.example.com/s/ShareToken",
                "hassourceurl": true,
                "isdefault": true,
                "isvisible": true,
                "editurl": "/mod/videoprogress/captions/edit.php?id=10&captionid=4",
                "togglelabel": "Hide captions",
                "toggleurl": "/mod/videoprogress/captions.php?id=10&action=toggle&captionid=4&sesskey=examplesesskey",
                "deleteurl": "/mod/videoprogress/captions.php?id=10&action=delete&captionid=4&sesskey=examplesesskey",
                "id": 4
            }
        ]
    }
}}

<div class="videoprogress-captions">
    <header class="videoprogress-report__header">
        <div>
            <a href="{{{backurl}}}" class="btn btn-secondary btn-sm mb-3 videoprogress-report__back">
                {{#str}} backtovideo, videoprogress {{/str}}
            </a>
            <h2>{{#str}} managecaptions, videoprogress {{/str}}</h2>
            <p>{{#str}} captionshelp, videoprogress {{/str}}</p>
        </div>
    </header>
    <section class="videoprogress-detail-section">
        <h3>{{#str}} captiontracks, videoprogress {{/str}}</h3>
        {{> mod_videoprogress/caption_list}}
    </section>
    <section class="videoprogress-detail-section">
        <h3>{{#str}} addcaption, videoprogress {{/str}}</h3>
        {{{formhtml}}}
    </section>
</div>
