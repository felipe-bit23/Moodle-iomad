{{!
    @template mod_videoprogress/view

    Example context (json):
    {
        "configjson": "{}",
        "name": "Vídeo de exemplo",
        "canviewreport": true,
        "reporturl": "/mod/videoprogress/report/report.php?id=10",
        "cancaptions": true,
        "captionsurl": "/mod/videoprogress/captions.php?id=10",
        "canmanageobjectives": true,
        "objectivesurl": "/mod/videoprogress/objectives.php?id=10",
        "canmanageresources": true,
        "manageurl": "/mod/videoprogress/manage.php?id=10",
        "hasintro": true,
        "intro": "<p>Introdução da atividade.</p>",
        "hascontentpoints": true,
        "hasobjectives": true,
        "objectives": [
            {
                "html": "<p>Identificar os elementos principais.</p>"
            }
        ],
        "player": {
            "source": true,
            "sourcehtml": "<video controls><source src=\"https://example.test/video.mp4\"></video>"
        },
        "contentoverlays": [
            {
                "html": "<div class=\"videoprogress-content-overlay\" hidden></div>"
            }
        ],
        "hasmaterials": true,
        "materials": [
            {
                "html": "<article class=\"videoprogress-material-card\"><h3>Guia</h3></article>"
            }
        ],
        "contentpoints": [
            {
                "id": 5,
                "timepoint": 90,
                "completed": false,
                "timecode": "01:30",
                "title": "Ponto de interação",
                "hasitems": true,
                "items": [
                    {
                        "name": "Quiz"
                    }
                ]
            }
        ],
        "progress": {
            "percentrounded": 72,
            "percent": 72.4,
            "watchedofduration": "07:12 / 10:00",
            "requiredpercent": 80,
            "completed": false,
            "inprogress": true,
            "notstarted": false
        },
        "timeline": [
            {
                "level": 1,
                "tooltip": "00:00–00:10",
                "start": 0,
                "end": 10,
                "views": 1
            },
            {
                "level": 3,
                "tooltip": "00:10–00:20",
                "start": 10,
                "end": 20,
                "views": 3
            }
        ],
        "timelinealternative": "A maior parte do início do vídeo foi assistida.",
        "confirmation": {
            "required": true,
            "available": true,
            "confirmed": false,
            "url": "/mod/videoprogress/view.php?id=10",
            "sesskey": "examplesesskey"
        }
    }
}}

<div class="videoprogress-view" data-region="videoprogress" data-config="{{configjson}}">
    <header class="videoprogress-view__header">
        <h2>{{{name}}}</h2>
        <div class="videoprogress-view__actions">
            {{#canviewreport}}
                <a class="btn btn-outline-primary"
                   href="{{{reporturl}}}">{{#str}}viewreport, videoprogress {{/str}}</a>
            {{/canviewreport}}
            {{#canmanageresources}}
                <a class="btn btn-outline-secondary"
                   href="{{{manageurl}}}">{{#str}}manageresources, videoprogress {{/str}}</a>
            {{/canmanageresources}}
        </div>
    </header>
    {{#hasintro}}
        <div class="videoprogress-intro">{{{intro}}}</div>
    {{/hasintro}}
    <div class="videoprogress-learning-layout {{^hascontentpoints}}without-content{{/hascontentpoints}}">
        <main class="videoprogress-learning-layout__main">
            {{#hasobjectives}}{{> mod_videoprogress/objectives}}{{/hasobjectives}}
            {{> mod_videoprogress/player}}
            {{#hasmaterials}}{{> mod_videoprogress/support_materials}}{{/hasmaterials}}
        </main>
        {{#hascontentpoints}}{{> mod_videoprogress/video_content}}{{/hascontentpoints}}
    </div>
    {{> mod_videoprogress/progress}}
    {{> mod_videoprogress/timeline}}
    {{#confirmation.required}}{{> mod_videoprogress/confirmation}}{{/confirmation.required}}
    <div class="alert alert-warning d-none" data-region="tracking-message" role="status"></div>
</div>
