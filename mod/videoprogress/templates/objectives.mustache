{{!
    @template mod_videoprogress/objectives

    Example context (json):
    {
        "objectives": [
            {
                "html": "<p>Identificar os elementos principais do conteúdo.</p>"
            }
        ]
    }
}}

<section class="videoprogress-objectives" aria-labelledby="videoprogress-objectives-heading">
    <div class="videoprogress-objectives__icon" aria-hidden="true">✓</div>
    <div>
        <h3 id="videoprogress-objectives-heading">{{#str}} objectivestitle, videoprogress {{/str}}</h3>
        <p>{{#str}} objectivesintro, videoprogress {{/str}}</p>
        <ul>
            {{#objectives}}
                <li>{{{html}}}</li>
            {{/objectives}}
        </ul>
    </div>
</section>
