{{!
    @template mod_videoprogress/player

    Example context (json):
    {
        "player": {
            "source": true,
            "sourcehtml": "<video controls><source src=\"https://example.test/video.mp4\"></video>"
        },
        "contentoverlays": [
            {
                "html": "<div class=\"videoprogress-content-overlay\" hidden></div>"
            }
        ]
    }
}}

<section class="videoprogress-player-card" aria-labelledby="videoprogress-player-heading">
    <h3 id="videoprogress-player-heading" class="sr-only">{{#str}} player, videoprogress {{/str}}</h3>
    <div class="videoprogress-player" data-region="player">
        {{#player.source}}
            {{{player.sourcehtml}}}
        {{/player.source}}
        {{#contentoverlays}}{{{html}}}{{/contentoverlays}}
    </div>
</section>
