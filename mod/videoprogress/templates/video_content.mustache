{{!
    @template mod_videoprogress/video_content

    Example context (json):
    {
        "contentpoints": [
            {
                "id": 5,
                "timepoint": 90,
                "completed": false,
                "timecode": "01:30",
                "title": "Ponto de interação",
                "hasitems": true,
                "items": [
                    {
                        "name": "Nota"
                    },
                    {
                        "name": "Quiz"
                    }
                ]
            }
        ]
    }
}}

<aside class="videoprogress-video-content" aria-labelledby="videoprogress-content-heading">
    <div class="videoprogress-video-content__header">
        <h3 id="videoprogress-content-heading">{{#str}} videocontent, videoprogress {{/str}}</h3>
    </div>
    <ol class="videoprogress-video-content__list">
        {{#contentpoints}}
            <li>
                <button type="button" data-content-point="{{id}}" data-time="{{timepoint}}"
                        class="videoprogress-video-content__point">
                    <span class="videoprogress-video-content__status">
                        {{#completed}}
                            <span aria-hidden="true">✓</span>
                        <span class="sr-only">{{#str}}statuscompleted, videoprogress {{/str}}</span>
                        {{/completed}}
                        {{^completed}}{{{timecode}}}{{/completed}}
                    </span>
                    <span class="videoprogress-video-content__text">
                        <strong>{{{title}}}</strong>
                        {{#hasitems}}
                            <small>
                                {{#items}}
                                    <span>{{{name}}}</span>
                                {{/items}}
                            </small>
                        {{/hasitems}}
                    </span>
                    <span class="videoprogress-video-content__play" aria-hidden="true">▶</span>
                </button>
            </li>
        {{/contentpoints}}
    </ol>
</aside>
