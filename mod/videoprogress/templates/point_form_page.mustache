{{!
    @template mod_videoprogress/point_form_page

    Example context (json):
    {
        "backurl": "/mod/videoprogress/content.php?id=10",
        "title": "Editar ponto",
        "description": "O ponto aparecerá no roteiro lateral.",
        "formhtml": "<form></form>",
        "configjson": "{}",
        "player": {
            "source": "upload",
            "sourcehtml": "<video controls></video>"
        }
    }
}}

<div class="videoprogress-form-page videoprogress-point-form-page">
    <a href="{{{backurl}}}" class="btn btn-secondary btn-sm mb-3 videoprogress-report__back">
        {{#str}} back, videoprogress {{/str}}
    </a>
    <h2>{{{title}}}</h2>
    <p>{{{description}}}</p>

    <div class="videoprogress-point-form-page__layout">
        <div class="videoprogress-form-page__form">
            {{{formhtml}}}
        </div>

        <aside class="videoprogress-point-timepicker"
               data-region="point-time-picker"
               data-config="{{configjson}}">
            <header class="videoprogress-point-timepicker__header">
                <h3>{{#str}} pointtime, videoprogress {{/str}}</h3>
                <p>{{#str}} pointtime_help, videoprogress {{/str}}</p>
            </header>

            {{> mod_videoprogress/player}}

            <div class="videoprogress-point-timepicker__controls">
                <div class="videoprogress-point-timepicker__time" aria-live="polite">
                    <span>{{#str}} pointtime, videoprogress {{/str}}</span>
                    <strong>
                        <span data-region="point-current-time">00:00</span>
                        <span aria-hidden="true"> / </span>
                        <span data-region="point-duration">00:00</span>
                    </strong>
                </div>
                <button type="button" class="btn btn-primary" data-action="point-use-current-time">
                    {{#str}} applycurrenttime, videoprogress {{/str}}
                </button>
            </div>

            <div class="alert alert-warning d-none mt-3"
                 data-region="point-player-error"
                 role="status"></div>
        </aside>
    </div>
</div>
