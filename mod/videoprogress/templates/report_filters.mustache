{{!
    @template mod_videoprogress/report_filters

    Example context (json):
    {
        "filters": {
            "action": "/mod/videoprogress/report/report.php",
            "cmid": 10,
            "search": "",
            "groups": [
                {
                    "value": "0",
                    "selected": true,
                    "label": "Todos os grupos"
                }
            ],
            "statuses": [
                {
                    "value": "",
                    "selected": true,
                    "label": "Todos os status"
                }
            ],
            "percentranges": [
                {
                    "value": "",
                    "selected": true,
                    "label": "Todos os percentuais"
                }
            ],
            "lastviews": [
                {
                    "value": "",
                    "selected": true,
                    "label": "Qualquer acesso"
                }
            ],
            "sorts": [
                {
                    "value": "fullname",
                    "selected": true,
                    "label": "Nome"
                }
            ],
            "directions": [
                {
                    "value": "ASC",
                    "selected": true,
                    "label": "Crescente"
                }
            ],
            "perpages": [
                {
                    "value": "20",
                    "selected": true,
                    "label": "20"
                }
            ]
        }
    }
}}

<section class="videoprogress-filters" aria-labelledby="videoprogress-filters-heading">
    <h3 id="videoprogress-filters-heading">{{#str}} filters, videoprogress {{/str}}</h3>
    <form method="get" action="{{{filters.action}}}" class="videoprogress-filters__form">
        <input type="hidden" name="id" value="{{{filters.cmid}}}">
        <div class="form-group videoprogress-filter-search">
            <label for="videoprogress-search">{{#str}} searchstudents, videoprogress {{/str}}</label>
            <input id="videoprogress-search" name="search" type="search" class="form-control" value="{{{filters.search}}}"
                   placeholder="{{#str}} searchplaceholder, videoprogress {{/str}}">
        </div>
        <div class="form-group">
            <label for="videoprogress-group">{{#str}} group, videoprogress {{/str}}</label>
            <select id="videoprogress-group" name="groupid" class="form-control">
                {{#filters.groups}}
                    <option value="{{{value}}}" {{#selected}}selected{{/selected}}>{{{label}}}</option>
                {{/filters.groups}}
            </select>
        </div>
        <div class="form-group">
            <label for="videoprogress-status">{{#str}} status, videoprogress {{/str}}</label>
            <select id="videoprogress-status" name="status" class="form-control">
                {{#filters.statuses}}
                    <option value="{{{value}}}" {{#selected}}selected{{/selected}}>{{{label}}}</option>
                {{/filters.statuses}}
            </select>
        </div>
        <div class="form-group">
            <label for="videoprogress-percent">{{#str}} percentage, videoprogress {{/str}}</label>
            <select id="videoprogress-percent" name="percentrange" class="form-control">
                {{#filters.percentranges}}
                    <option value="{{{value}}}"
                            {{#selected}}selected{{/selected}}>{{{label}}}</option>
                {{/filters.percentranges}}
            </select>
        </div>
        <div class="form-group">
            <label for="videoprogress-lastview">{{#str}} lastview, videoprogress {{/str}}</label>
            <select id="videoprogress-lastview" name="lastview" class="form-control">
                {{#filters.lastviews}}
                    <option value="{{{value}}}" {{#selected}}selected{{/selected}}>{{{label}}}</option>
                {{/filters.lastviews}}
            </select>
        </div>
        <div class="form-group">
            <label for="videoprogress-sort">{{#str}} sortby, videoprogress {{/str}}</label>
            <select id="videoprogress-sort" name="sort" class="form-control">
                {{#filters.sorts}}
                    <option value="{{{value}}}" {{#selected}}selected{{/selected}}>{{{label}}}</option>
                {{/filters.sorts}}
            </select>
        </div>
        <div class="form-group">
            <label for="videoprogress-direction">{{#str}} direction, videoprogress {{/str}}</label>
            <select id="videoprogress-direction" name="direction" class="form-control">
                {{#filters.directions}}
                    <option value="{{{value}}}"
                            {{#selected}}selected{{/selected}}>{{{label}}}</option>
                {{/filters.directions}}
            </select>
        </div>
        <div class="form-group">
            <label for="videoprogress-perpage">{{#str}} perpage, videoprogress {{/str}}</label>
            <select id="videoprogress-perpage" name="perpage" class="form-control">
                {{#filters.perpages}}
                    <option value="{{{value}}}" {{#selected}}selected{{/selected}}>{{{label}}}</option>
                {{/filters.perpages}}
            </select>
        </div>
        <button type="submit" class="btn btn-primary">{{#str}} applyfilters, videoprogress {{/str}}</button>
    </form>
</section>
