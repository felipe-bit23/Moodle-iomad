{{!
    @template mod_videoprogress/manage_content

    Example context (json):
    {
        "backurl": "/mod/videoprogress/view.php?id=10",
        "activityname": "Vídeo de exemplo",
        "addpointurl": "/mod/videoprogress/content/point.php?id=10",
        "haspoints": true,
        "points": [
            {
                "timecode": "01:30",
                "title": "Ponto de interação",
                "disabled": false,
                "editurl": "/mod/videoprogress/content/point.php?id=10&pointid=5",
                "deleteurl": "/mod/videoprogress/content/delete.php?id=10&pointid=5",
                "items": [
                    {
                        "name": "Pergunta",
                        "disabled": false,
                        "editurl": "/edit",
                        "deleteurl": "/delete"
                    }
                ],
                "hasitems": true,
                "addurls": [
                    {
                        "url": "/add-note",
                        "name": "Nota"
                    },
                    {
                        "url": "/add-quiz",
                        "name": "Quiz"
                    }
                ]
            }
        ]
    }
}}

<div class="videoprogress-manage">
    <a href="{{{backurl}}}" class="btn btn-secondary btn-sm mb-3 videoprogress-report__back">
        {{#str}} backtovideo, videoprogress {{/str}}
    </a>
    <div class="videoprogress-manage__heading">
        <div>
            <h2>{{#str}} managevideocontent, videoprogress {{/str}}</h2>
            <p>{{#str}} managecontenthelp, videoprogress {{/str}}</p>
        </div>
        <a class="btn btn-primary" href="{{{addpointurl}}}">{{#str}} addpoint, videoprogress {{/str}}</a>
    </div>
    {{#haspoints}}
        <div class="videoprogress-point-list">
            {{#points}}
            <article class="videoprogress-point-editor">
                <header>
                    <div>
                        <time>{{{timecode}}}</time>
                        <h3>{{{title}}}</h3>
                        {{#disabled}}
                            <span class="badge badge-secondary">{{#str}}disabled, videoprogress {{/str}}</span>
                        {{/disabled}}
                    </div>
                    <div>
                        <a class="btn btn-sm btn-outline-primary"
                           href="{{{editurl}}}">{{#str}}editpoint, videoprogress {{/str}}</a>
                        <a class="btn btn-sm btn-outline-danger"
                           href="{{{deleteurl}}}">{{#str}}delete, videoprogress {{/str}}</a>
                    </div>
                </header>
                <div class="videoprogress-point-editor__items">
                    {{#items}}
                        <div>
                            <span>{{{name}}}{{#disabled}}· {{#str}} disabled, videoprogress {{/str}}{{/disabled}}</span>
                            <span>
                                <a class="btn btn-sm btn-outline-primary"
                                   href="{{{editurl}}}">{{#str}}edit, videoprogress {{/str}}</a>
                                <a class="btn btn-sm btn-outline-danger ml-1"
                                   href="{{{deleteurl}}}">{{#str}}delete, videoprogress {{/str}}</a>
                            </span>
                        </div>
                    {{/items}}
                    {{^hasitems}}
                        <p>{{#str}} pointwithoutplugins, videoprogress {{/str}}</p>
                    {{/hasitems}}
                </div>
                <div class="dropdown">
                    <button class="btn btn-sm btn-outline-primary dropdown-toggle" type="button"
                            data-toggle="dropdown" data-bs-toggle="dropdown">{{#str}} addpointcontent, videoprogress {{/str}}</button>
                    <div class="dropdown-menu">
                        {{#addurls}}
                            <a class="dropdown-item" href="{{{url}}}">{{{name}}}</a>
                        {{/addurls}}
                    </div>
                </div>
            </article>
        {{/points}}
        </div>
    {{/haspoints}}
    {{^haspoints}}
        <div class="videoprogress-empty"><h3>{{#str}} nopoints, videoprogress {{/str}}</h3>
            <p>{{#str}} nopointshelp, videoprogress {{/str}}</p></div>
    {{/haspoints}}
</div>
