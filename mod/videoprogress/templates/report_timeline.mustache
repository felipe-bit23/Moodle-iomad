{{!
    @template mod_videoprogress/report_timeline

    Example context (json):
    {
        "hasaggregateddata": true,
        "aggregatetimeline": [
            {
                "level": 2,
                "tooltip": "00:00–00:10"
            },
            {
                "level": 4,
                "tooltip": "00:10–00:20"
            }
        ],
        "insights": {
            "mostwatched": {
                "range": "00:10–00:20",
                "views": 18
            },
            "leastwatched": {
                "range": "09:40–09:50",
                "views": 3
            },
            "dropoff": {
                "range": "06:20–06:30",
                "views": 5
            }
        }
    }
}}

<section class="videoprogress-report-timeline" aria-labelledby="videoprogress-mostwatched-heading">
    <div class="videoprogress-section-heading">
        <h3 id="videoprogress-mostwatched-heading">{{#str}} mostwatchedmoments, videoprogress {{/str}}</h3>
        <p>{{#str}} mostwatchedhelp, videoprogress {{/str}}</p>
    </div>
    {{#hasaggregateddata}}
        <div class="videoprogress-timeline is-aggregate" role="img"
             aria-label="{{#str}} reporttimelineaccessible, videoprogress {{/str}}">
            {{#aggregatetimeline}}
                <span class="videoprogress-timeline__bucket level-{{{level}}}" tabindex="0"
                      title="{{{tooltip}}}"></span>
            {{/aggregatetimeline}}
        </div>
        <div class="videoprogress-insights">
            {{#insights.mostwatched}}
                <article>
                    <span>{{#str}}mostwatchedsection, videoprogress {{/str}}</span>
                    <h3>{{{range}}}</h3>
                    <small>{{#str}}viewsamount, videoprogress, {{{views}}} {{/str}}</small>
                </article>
            {{/insights.mostwatched}}
            {{#insights.leastwatched}}
                <article>
                    <span>{{#str}}leastwatchedsection, videoprogress {{/str}}</span>
                    <h3>{{{range}}}</h3>
                    <small>{{#str}}viewsamount, videoprogress, {{{views}}} {{/str}}</small>
                </article>
            {{/insights.leastwatched}}
            {{#insights.dropoff}}
                <article>
                    <span>{{#str}}largestdropoff, videoprogress {{/str}}</span>
                    <h3>{{{range}}}</h3>
                    <small>{{#str}}viewdrop, videoprogress, {{{views}}} {{/str}}</small>
                </article>
            {{/insights.dropoff}}
        </div>
    {{/hasaggregateddata}}
    {{^hasaggregateddata}}
        <p class="videoprogress-muted-panel">{{#str}} noanalyticsyet, videoprogress {{/str}}</p>
    {{/hasaggregateddata}}
</section>
