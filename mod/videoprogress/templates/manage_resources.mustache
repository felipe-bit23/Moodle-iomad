{{!
    @template mod_videoprogress/manage_resources

    Example context (json):
    {
        "backurl": "/mod/videoprogress/view.php?id=10",
        "activityname": "Vídeo de exemplo",
        "canobjectives": true,
        "objectivesurl": "/mod/videoprogress/objectives.php?id=10",
        "canmaterials": true,
        "materialsurl": "/mod/videoprogress/materials.php?id=10",
        "cancontent": true,
        "contenturl": "/mod/videoprogress/content.php?id=10"
    }
}}

<div class="videoprogress-manage">
    <a href="{{{backurl}}}" class="btn btn-secondary btn-sm mb-3 videoprogress-report__back">
        {{#str}} backtovideo, videoprogress {{/str}}
    </a>
    <h2>{{#str}} manageresources, videoprogress {{/str}}</h2>
    <p>{{#str}} manageresourceshelp, videoprogress {{/str}}</p>
    <div class="videoprogress-manage__cards">
        {{#cancaptions}}
            <a class="btn btn-outline-secondary"
               href="{{{captionsurl}}}">
                <strong>{{#str}}managecaptions, videoprogress {{/str}}</strong>
                <span>{{#str}}managecaptionshelp, videoprogress {{/str}}</span>
            </a>
        {{/cancaptions}}
        {{#canobjectives}}
            <a class="btn btn-outline-secondary"
               href="{{{objectivesurl}}}">
                <strong>{{#str}} learningobjectives, videoprogress {{/str}}</strong>
                <span>{{#str}}manageobjectiveshelp, videoprogress {{/str}}</span>
            </a>
        {{/canobjectives}}
        {{#canmaterials}}
            <a class="btn btn-outline-secondary"
               href="{{{materialsurl}}}">
                <strong>{{#str}} supportmaterials, videoprogress {{/str}}</strong>
                <span>{{#str}}managematerialshelp, videoprogress {{/str}}</span>
            </a>
        {{/canmaterials}}
        {{#cancontent}}
            <a class="btn btn-outline-secondary"
               href="{{{contenturl}}}">
                <strong>{{#str}} videocontent, videoprogress {{/str}}</strong>
                <span>{{#str}}managecontenthelp, videoprogress {{/str}}</span>
            </a>
        {{/cancontent}}
    </div>
</div>
