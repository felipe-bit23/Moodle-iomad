{{!
    @template mod_videoprogress/timeline

    Example context (json):
    {
        "timeline": [
            {
                "level": 1,
                "tooltip": "00:00–00:10",
                "start": 0,
                "end": 10,
                "views": 1
            },
            {
                "level": 3,
                "tooltip": "00:10–00:20",
                "start": 10,
                "end": 20,
                "views": 3
            }
        ],
        "timelinealternative": "A maior parte do início do vídeo foi assistida."
    }
}}

<section class="videoprogress-timeline-section" aria-labelledby="videoprogress-timeline-heading">
    <div class="videoprogress-section-heading">
        <h3 id="videoprogress-timeline-heading">{{#str}} yourtimeline, videoprogress {{/str}}</h3>
        <p>{{#str}} timelinehelp, videoprogress {{/str}}</p>
    </div>
    <div class="videoprogress-timeline" data-region="timeline" role="img"
         aria-label="{{#str}} timelineaccessible, videoprogress {{/str}}">
        {{#timeline}}
            <span class="videoprogress-timeline__bucket level-{{{level}}}" tabindex="0" title="{{{tooltip}}}"
                  data-start="{{{start}}}" data-end="{{{end}}}" data-views="{{{views}}}"></span>
        {{/timeline}}
    </div>
    <p class="sr-only" data-region="timeline-alternative">{{{timelinealternative}}}</p>
    <div class="videoprogress-timeline__legend" aria-hidden="true">
        <span>{{#str}} notwatched, videoprogress {{/str}}</span>
        <span class="videoprogress-timeline__legend-scale"></span>
        <span>{{#str}} rewatched, videoprogress {{/str}}</span>
    </div>
</section>
