{{!
    @template mod_videoprogress/report_student

    Example context (json):
    {
        "backurl": "/mod/videoprogress/report/report.php?id=10",
        "activityname": "Vídeo de exemplo",
        "fullname": "Aluno Exemplo",
        "email": "aluno@example.test",
        "canreset": true,
        "reseturl": "/mod/videoprogress/report/reset.php?id=10&userid=2",
        "percent": 72,
        "uniquewatched": "07:12",
        "totalwatchtime": "09:40",
        "lastposition": "08:05",
        "status": "Em andamento",
        "lastview": "12/08/2026 00:05",
        "timeline": [
            {
                "level": 2,
                "tooltip": "00:00–00:10"
            },
            {
                "level": 4,
                "tooltip": "00:10–00:20"
            }
        ],
        "timelinealternative": "O aluno assistiu 72% do conteúdo.",
        "hasobjectives": true,
        "objectives": [
            {
                "html": "<p>Identificar os elementos principais.</p>"
            }
        ],
        "confirmation": true,
        "confirmationtime": "12/08/2026 00:01",
        "hassessions": true,
        "sessions": [
            {
                "date": "12/08/2026",
                "duration": "00:12:00",
                "watchtime": "00:09:40",
                "range": "00:00–08:05"
            }
        ]
    }
}}

<div class="videoprogress-student-detail">
    <header class="videoprogress-report__header">
        <div>
            <a href="{{{backurl}}}" class="btn btn-secondary btn-sm mb-3 videoprogress-report__back">
                {{#str}} backtoreport, videoprogress {{/str}}
            </a>
            <h2>{{{fullname}}}</h2>
            <p>{{{email}}}</p>
        </div>
        {{#canreset}}
            <a href="{{{reseturl}}}"
               class="btn btn-outline-danger">{{#str}}resetprogress, videoprogress {{/str}}</a>
        {{/canreset}}
    </header>
    <section class="videoprogress-detail-metrics">
        <article><h3>{{{percent}}}%</h3><span>{{#str}} progress, videoprogress {{/str}}</span></article>
        <article><h3>{{{uniquewatched}}}</h3><span>{{#str}} uniquewatched, videoprogress {{/str}}</span></article>
        <article><h3>{{{totalwatchtime}}}</h3><span>{{#str}} totalwatchtime, videoprogress {{/str}}</span></article>
        <article><h3>{{{lastposition}}}</h3><span>{{#str}} lastposition, videoprogress {{/str}}</span></article>
        <article><h3>{{{status}}}</h3><span>{{#str}} status, videoprogress {{/str}}</span></article>
        <article><h3>{{{lastview}}}</h3><span>{{#str}} lastview, videoprogress {{/str}}</span></article>
    </section>
    <section class="videoprogress-report-timeline">
        <h3>{{#str}} individualtimeline, videoprogress {{/str}}</h3>
        <div class="videoprogress-timeline" role="img"
             aria-label="{{#str}} individualtimelinearia, videoprogress, {{{fullname}}} {{/str}}">
            {{#timeline}}
                <span class="videoprogress-timeline__bucket level-{{{level}}}" tabindex="0"
                      title="{{{tooltip}}}"></span>
            {{/timeline}}
        </div>
        <p class="sr-only">{{{timelinealternative}}}</p>
    </section>
    <section class="videoprogress-detail-section">
        <h3>{{#str}} confirmationtitle, videoprogress {{/str}}</h3>
        {{#confirmation}}
            <p class="text-success">{{#str}}confirmationdetail, videoprogress, {{{confirmationtime}}} {{/str}}</p>
        {{/confirmation}}
        {{^confirmation}}
            <p>{{#str}} notconfirmed, videoprogress {{/str}}</p>
        {{/confirmation}}
    </section>
    <section class="videoprogress-detail-section">
        <h3>{{#str}} sessions, videoprogress {{/str}}</h3>
        {{#hassessions}}
            <div class="videoprogress-sessions">
                {{#sessions}}
                    <article>
                        <h3>{{{date}}}</h3>
                        <span>{{#str}}sessionduration, videoprogress, {{{duration}}} {{/str}}</span>
                        <span>{{#str}}sessionwatchtime, videoprogress, {{{watchtime}}} {{/str}}</span>
                        <span>{{{range}}}</span>
                    </article>
                {{/sessions}}
            </div>
        {{/hassessions}}
        {{^hassessions}}
            <p>{{#str}} nosessions, videoprogress {{/str}}</p>
        {{/hassessions}}
    </section>
</div>
