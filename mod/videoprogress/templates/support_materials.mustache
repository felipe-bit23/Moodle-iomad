{{!
    @template mod_videoprogress/support_materials

    Example context (json):
    {
        "canmanagematerials": true,
        "materialsmanageurl": "/mod/videoprogress/materials.php?id=10",
        "materials": [
            {
                "html": "<article class=\"videoprogress-material-card\"><h3>Guia de estudo</h3></article>"
            }
        ]
    }
}}

<section class="videoprogress-support-materials" aria-labelledby="videoprogress-materials-heading">
    <div class="videoprogress-section-heading d-flex justify-content-between align-items-start flex-wrap">
        <div>
            <h3 id="videoprogress-materials-heading">{{#str}} supportmaterials, videoprogress {{/str}}</h3>
            <p>{{#str}} supportmaterialshelp, videoprogress {{/str}}</p>
        </div>
        {{#canmanagematerials}}
            <a class="btn btn-sm btn-outline-primary mb-2" href="{{{materialsmanageurl}}}">
                {{#str}} managematerials, videoprogress {{/str}}
            </a>
        {{/canmanagematerials}}
    </div>
    <div class="videoprogress-support-materials__grid">
        {{#materials}}{{{html}}}{{/materials}}
    </div>
</section>
