{{!
    @template mod_videoprogress/caption_list

    Example context (json):
    {
        "hascaptions": true,
        "captions": [
            {
                "label": "Portuguese (Brazil)",
                "language": "pt-BR",
                "status": "Published",
                "source": "Nextcloud URL",
                "sourceurl": "https://cloud.example.com/s/ShareToken",
                "hassourceurl": true,
                "isdefault": true,
                "isvisible": true,
                "editurl": "/mod/videoprogress/captions/edit.php?id=10&captionid=4",
                "togglelabel": "Hide captions",
                "toggleurl": "/mod/videoprogress/captions.php?id=10&action=toggle&captionid=4&sesskey=examplesesskey",
                "deleteurl": "/mod/videoprogress/captions.php?id=10&action=delete&captionid=4&sesskey=examplesesskey",
                "id": 4
            }
        ]
    }
}}

{{#hascaptions}}
    <div class="videoprogress-caption-list">
        {{#captions}}
            <article>
                <div class="videoprogress-caption-list__info">
                    <h3>{{{label}}}</h3>
                    <span>{{{language}}} · {{{status}}} · {{{source}}}</span>
                    {{#hassourceurl}}
                        <span class="videoprogress-caption-list__url">{{{sourceurl}}}</span>
                    {{/hassourceurl}}
                    {{#isdefault}}
                        <span class="badge badge-primary">{{#str}}default, videoprogress {{/str}}</span>
                    {{/isdefault}}
                    {{^isvisible}}
                        <span class="badge badge-secondary">{{#str}}captionhidden, videoprogress {{/str}}</span>
                    {{/isvisible}}
                </div>
                <div class="videoprogress-row-actions">
                    <a href="{{{editurl}}}" class="btn btn-sm btn-outline-primary">{{#str}}edit, videoprogress {{/str}}</a>
                    <a href="{{{toggleurl}}}" class="btn btn-sm btn-outline-secondary">{{{togglelabel}}}</a>
                    <a href="{{{deleteurl}}}" class="btn btn-sm btn-outline-danger"
                       data-action="delete-caption">{{#str}}delete, videoprogress {{/str}}</a>
                </div>
            </article>
        {{/captions}}
    </div>
{{/hascaptions}}
{{^hascaptions}}
    <p>{{#str}} nocaptions, videoprogress {{/str}}</p>
{{/hascaptions}}
