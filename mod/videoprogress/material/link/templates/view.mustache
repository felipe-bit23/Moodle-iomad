{{!
    @template videoprogressmaterial_link/view

    Example context (json):
    {
        "name": "Artigo complementar",
        "hasurl": true,
        "externalurl": "https://example.com/article",
        "host": "example.com",
        "opennewwindow": true
    }
}}
<section class="videoprogress-material-view videoprogress-material-view--link">
    <h3>{{{name}}}</h3>
    {{#hasurl}}
        {{#host}}<p class="text-muted mb-3">{{{host}}}</p>{{/host}}
        <a class="btn btn-primary" href="{{{externalurl}}}"{{#opennewwindow}} target="_blank" rel="noopener noreferrer"{{/opennewwindow}}>
            {{#str}}openlink, videoprogressmaterial_link{{/str}}
        </a>
    {{/hasurl}}
    {{^hasurl}}
        <div class="alert alert-info">{{#str}}nourl, videoprogressmaterial_link{{/str}}</div>
    {{/hasurl}}
</section>
