{{!
    @template videoprogressmaterial_link/card

    Example context (json):
    {
        "name": "Artigo complementar",
        "viewurl": "/mod/videoprogress/material/view.php?id=10&materialid=6"
    }
}}
<article class="videoprogress-material-card videoprogress-material-card--link">
    <span class="videoprogress-material-card__icon" aria-hidden="true">{{#str}}linkbadge, videoprogressmaterial_link{{/str}}</span>
    <h3>{{{name}}}</h3>
    <a href="{{{viewurl}}}" class="stretched-link">
        <span class="sr-only">{{#str}}viewlink, videoprogressmaterial_link{{/str}}</span>
    </a>
</article>
