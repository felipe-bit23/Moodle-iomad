{{!
    @template videoprogressmaterial_pdf/view

    Example context (json):
    {
        "name": "Material em PDF",
        "allowdownload": true,
        "downloadurl": "https://example.test/material.pdf?download=1",
        "hasfile": true,
        "fileurl": "https://example.test/material.pdf"
    }
}}

<section class="videoprogress-material-view videoprogress-material-view--pdf">
    <header>
        <h2>{{{name}}}</h2>
        {{#allowdownload}}
            <a class="btn btn-primary" href="{{{downloadurl}}}">{{#str}}downloaddocument, videoprogressmaterial_pdf {{/str}}</a>
        {{/allowdownload}}
    </header>
    {{#hasfile}}
        <iframe src="{{{fileurl}}}" title="{{{name}}}" loading="lazy"></iframe>
    {{/hasfile}}
    {{^hasfile}}
        <div class="alert alert-warning">{{#str}}documentunavailable, videoprogressmaterial_pdf {{/str}}</div>
    {{/hasfile}}
</section>
