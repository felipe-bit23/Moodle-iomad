{{!
    @template videoprogresscontent_quiz/overlay

    Example context (json):
    {
        "itemid": 16,
        "pointtitle": "Pergunta rápida",
        "question": "<p>Qual alternativa está correta?</p>",
        "answers": [
            {
                "index": 0,
                "number": "A",
                "text": "Primeira alternativa"
            },
            {
                "index": 1,
                "number": "B",
                "text": "Segunda alternativa"
            }
        ]
    }
}}

<section class="videoprogress-content-overlay videoprogress-content-overlay--quiz" data-content-item="{{itemid}}"
         hidden>
    <div class="videoprogress-content-overlay__panel">
        <h3>{{{pointtitle}}}</h3>
        <div class="videoprogress-content-overlay__body">{{{question}}}</div>
        <div class="videoprogress-quiz-answers">
            {{#answers}}
                <button type="button" class="videoprogress-quiz-answer" data-answer="{{index}}">
                    <span>{{{number}}}</span>{{{text}}}
                </button>
            {{/answers}}
        </div>
        <div class="videoprogress-content-overlay__feedback" data-region="interaction-feedback" role="status"></div>
    </div>
</section>
