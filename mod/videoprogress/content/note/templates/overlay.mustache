{{!
    @template videoprogresscontent_note/overlay

    Example context (json):
    {
        "itemid": 15,
        "pointtitle": "Observação importante",
        "message": "<p>Confira este detalhe antes de continuar.</p>"
    }
}}

<section class="videoprogress-content-overlay videoprogress-content-overlay--note" data-content-item="{{itemid}}"
         hidden>
    <div class="videoprogress-content-overlay__panel">
        <h3>{{{pointtitle}}}</h3>
        <div class="videoprogress-content-overlay__body">{{{message}}}</div>
        <div class="videoprogress-content-overlay__feedback" data-region="interaction-feedback" role="status"></div>
        <button type="button" class="btn btn-primary"
                data-action="acknowledge">{{#str}}acknowledge, videoprogresscontent_note {{/str}}</button>
    </div>
</section>
