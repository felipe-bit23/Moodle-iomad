{{!
    @template videoprogresssource_upload/player

    Example context (json):
    {
        "player": {
            "poster": "https://example.test/poster.jpg",
            "disabledownload": false,
            "disablepip": false,
            "url": "https://example.test/video.mp4",
            "captions": [
                {
                    "url": "https://example.test/captions.vtt",
                    "language": "pt-BR",
                    "label": "Português",
                    "isdefault": true
                }
            ]
        }
    }
}}

<video class="videoprogress-player__video" data-region="html5-player" controls preload="metadata"
       {{#player.poster}}poster="{{{player.poster}}}"{{/player.poster}}
    {{#player.disabledownload}}controlslist="nodownload"{{/player.disabledownload}}
    {{#player.disablepip}}disablepictureinpicture{{/player.disablepip}}>
    <source src="{{{player.url}}}">
    {{#player.captions}}
        <track kind="subtitles" src="{{{url}}}" srclang="{{{language}}}" label="{{{label}}}"
               {{#isdefault}}default{{/isdefault}}>
    {{/player.captions}}
    {{#str}} browservideonotsupported, videoprogress {{/str}}
</video>
